Show(
    key: '1',
    name: "Snowman 1",
    category: "Holiday & Specials",
    desc: "Snowman rotation loop",
    looping: true,
    program: [
        LoadWorking(frame: "snowman1"),
        HoldWorking(wait: "slp"),
        Rotate13,
        Hold(frame: "dark", wait: "slp"),
        HoldWorking(wait: "slp"),
        Rotate13,
        Hold(frame: "dark", wait: "slp"),
    ],
)
